# EdTech CRM & Inquiry Management System — Environment Variables
# Copy this file to .env and fill in your values before running the app.

# Application
ENVIRONMENT=development
DEBUG=True
APP_NAME=EdTech CRM & Inquiry Management System
APP_VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=8000

# Database — Supabase-managed PostgreSQL (or any PostgreSQL instance)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edtech_crm

# Security — CHANGE THESE IN PRODUCTION
SECRET_KEY=change-this-to-a-strong-random-secret-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password hashing
PASSWORD_HASH_SCHEME=argon2
